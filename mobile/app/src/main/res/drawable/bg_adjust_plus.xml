<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_strong" />
        </shape>
    </item>

    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size
                android:width="16dp"
                android:height="2dp" />
            <solid android:color="@color/adjust_symbol" />
        </shape>
    </item>

    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size
                android:width="2dp"
                android:height="16dp" />
            <solid android:color="@color/adjust_symbol" />
        </shape>
    </item>
</layer-list>
