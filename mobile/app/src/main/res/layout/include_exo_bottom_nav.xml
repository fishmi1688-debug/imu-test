<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/exoNavBluetoothItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_exo_nav_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="60dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/exoNavBluetoothIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/exo_nav_bluetooth"
                android:src="@drawable/ic_bluetooth_24" />

            <TextView
                android:id="@+id/exoNavBluetoothText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/exo_nav_bluetooth"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exoNavGaitItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_exo_nav_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="60dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/exoNavGaitIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/exo_nav_gait"
                android:src="@drawable/ic_tune_24" />

            <TextView
                android:id="@+id/exoNavGaitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/exo_nav_gait"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exoNavPlotItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_exo_nav_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="60dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/exoNavPlotIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/exo_nav_plot"
                android:src="@drawable/ic_chart_24" />

            <TextView
                android:id="@+id/exoNavPlotText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/exo_nav_plot"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exoNavGlassItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_exo_nav_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="60dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/exoNavGlassIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/exo_nav_glass"
                android:src="@drawable/ic_settings_24" />

            <TextView
                android:id="@+id/exoNavGlassText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/exo_nav_glass"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exoNavApiItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_exo_nav_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="60dp"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/exoNavApiIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/exo_nav_api"
                android:src="@drawable/ic_info_24" />

            <TextView
                android:id="@+id/exoNavApiText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/exo_nav_api"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
